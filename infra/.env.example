# AskRepo Compose stack — copy to `infra/.env` and uncomment what you need.
# What each one means, and why: ../docs/configuration.md
#
# Every value below is the fallback already baked into docker-compose.yml, so an
# empty file works. Leave a line commented to track the compose default.

# ── Required — no fallback, on purpose ────────────────────────────────────────
# A password committed here would be one every reader of this repo already has.
BOOTSTRAP_ADMIN_PASSWORD=

# ── Secrets — replace both before APP_ENV=production ──────────────────────────
#   openssl rand -hex 32
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# SECRET_KEY=dev-insecure-change-me
# PAT_ENCRYPTION_KEY=dev-insecure-change-me

# ── Application ───────────────────────────────────────────────────────────────
# APP_ENV=development
# APP_NAME=AskRepo API
# DEBUG=true
# TRUSTED_PROXY_HOPS=0

# ── Postgres credentials ──────────────────────────────────────────────────────
# POSTGRES_USER=askrepo
# POSTGRES_PASSWORD=askrepo
# POSTGRES_DB=askrepo

# ── Published ports — change when something else already holds one ────────────
# FRONTEND_PORT=3000
# BACKEND_PORT=8000
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# QDRANT_HTTP_PORT=6333
# QDRANT_GRPC_PORT=6334
# KAFKA_PORT=9092
# OLLAMA_PORT=11434   (only used when you opt into the containerised ollama)

# ── Embedding model — the API and the worker share these ──────────────────────
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_BASE_URL=http://host.docker.internal:11434
# EMBEDDING_API_KEY=

# ── Chat model — the API only ─────────────────────────────────────────────────
# CHAT_PROVIDER=ollama
# CHAT_MODEL=qwen2.5-coder:14b
# CHAT_BASE_URL=http://host.docker.internal:11434
# CHAT_API_KEY=

# ── Internal wiring — rarely touched ──────────────────────────────────────────
# API_URL=http://backend:8000
# KAFKA_CLUSTER_ID=TxqebIstTHqeFT1rjwosQQ

# ── Production only — docker-compose.prod.yml ─────────────────────────────────
# Required there, with no fallback: compose refuses to start without them.
# Check the whole set with `make setup-prod`.
# PUBLIC_ORIGIN=https://askrepo.internal.example.com
# POSTGRES_PASSWORD=
# TRUSTED_PROXY_HOPS=1
# Optional there:
# VERSION=latest
# WORKER_REPLICAS=2
# OLLAMA_VERSION=0.33.2

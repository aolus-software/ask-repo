# AskRepo backend — copy to `.env` and adjust.
# Every value below is a default baked into app/config.py; override only what you need.

# --- Application ---
APP_NAME="AskRepo API"
APP_VERSION="0.1.0"
APP_ENV=development          # development | production
DEBUG=true

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS ---
# Must be a JSON array. Add your frontend origin(s) here.
CORS_ORIGINS=["http://localhost:3000"]

# --- Datastores ---
# Not read by any code yet — wired ahead of the milestones that use them.
# Inside Docker Compose the hosts are the service names (`postgres`, `qdrant`,
# `redis`); running the API on the host, use `localhost`.

# Users, projects, qa_pairs (M0 onward).
DATABASE_URL=postgresql://askrepo:askrepo@localhost:5432/askrepo

# Vector store for indexed code chunks (M1 onward).
QDRANT_URL=http://localhost:6333

# Rate limiting (M0), then the clone+index job queue (M1, ARQ).
REDIS_URL=redis://localhost:6379/0

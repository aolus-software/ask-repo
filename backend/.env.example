# AskRepo backend — copy to `.env` and adjust.
# Every value below is the default from app/config.py; override only what you need.
# What each one means, and why: ../docs/configuration.md

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="AskRepo API"
APP_VERSION="0.1.0"
APP_ENV=development
DEBUG=true

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# ── Datastores ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://askrepo:askrepo@localhost:5432/askrepo
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# ── Secrets — replace both before APP_ENV=production; the app refuses to boot ──
#   openssl rand -hex 32
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SECRET_KEY=dev-insecure-change-me
PAT_ENCRYPTION_KEY=dev-insecure-change-me

# ── Auth ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=askrepo_refresh
REFRESH_COOKIE_PATH=/auth
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
REFRESH_ROTATION_GRACE_SECONDS=10

# ── Passwords ─────────────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_BYTES=72
BCRYPT_COST=12
# COMMON_PASSWORD_LIST_PATH=

# ── Bootstrap admins ──────────────────────────────────────────────────────────
BOOTSTRAP_ADMIN_EMAILS=["superuser@example.com","admin@example.com"]
BOOTSTRAP_ADMIN_PASSWORD=

# ── Login rate limiting ───────────────────────────────────────────────────────
LOGIN_RATE_PER_MINUTE_IP=5
LOGIN_RATE_PER_HOUR_EMAIL=10
TRUSTED_PROXY_HOPS=0

# ── Kafka — ingestion job queue ───────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INGEST_TOPIC=askrepo.ingest.requested
KAFKA_CONSUMER_GROUP=askrepo-ingest
KAFKA_INGEST_PARTITIONS=2
KAFKA_MAX_ATTEMPTS=3
KAFKA_CHECKLIST_TOPIC=askrepo.checklist.generate
KAFKA_CHECKLIST_PARTITIONS=1
CHECKLIST_MAP_CONCURRENCY=4
CHECKLIST_SCROLL_PAGE_SIZE=256
CHECKLIST_MAX_FILES_PER_JOB=200
KAFKA_MOCK_DATA_TOPIC=askrepo.mock-data.generate
KAFKA_MOCK_DATA_PARTITIONS=1
MOCK_DATA_SCROLL_PAGE_SIZE=256
MOCK_DATA_MAX_FILES_PER_JOB=200
MOCK_DATA_EXPORT_MAX_ROWS=5000

# ── Checklist module path picker ──────────────────────────────────────────────
INDEXED_PATH_SCROLL_PAGE_SIZE=1024
INDEXED_PATH_CACHE_TTL_SECONDS=300
INDEXED_PATH_CACHE_MAX_PROJECTS=32
INDEXED_PATH_SEARCH_LIMIT=200

# ── Embedding model ───────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=64

# ── Ingestion ─────────────────────────────────────────────────────────────────
REPO_HOST_ALLOWLIST=["github.com","gitlab.com"]
CLONE_TIMEOUT_SECONDS=120
REPO_MAX_SIZE_MB=500
REPO_SCRATCH_DIR=/data/repos
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
MAX_INDEXED_FILE_BYTES=1048576

# ── Chat model ────────────────────────────────────────────────────────────────
CHAT_PROVIDER=ollama
CHAT_MODEL=qwen2.5-coder:14b
CHAT_BASE_URL=http://localhost:11434
CHAT_API_KEY=
CHAT_TEMPERATURE=0.1
CHAT_TIMEOUT_SECONDS=180
CHAT_MAX_CONCURRENCY=2

# ── Retrieval ─────────────────────────────────────────────────────────────────
RAG_TOP_K=12
RAG_CONTEXT_MAX_CHARS=24000
RAG_HISTORY_TURNS=6
RAG_MIN_SCORE=0.25
RAG_MAX_RETRIEVAL_ATTEMPTS=2
RAG_GRADE_EVIDENCE=true
RAG_CLASSIFY_INTENT=true
RAG_PROPOSE_CHANGES=true

# ── Checklist ─────────────────────────────────────────────────────────────────
CHECKLIST_EXPORT_MAX_ROWS=5000
